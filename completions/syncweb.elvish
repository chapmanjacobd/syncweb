
use builtin;
use str;

set edit:completion:arg-completer[syncweb] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'syncweb'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'syncweb'= {
            cand --data-dir 'Directory used for persistent node identity and data'
            cand --network 'Network name for scoped operations (uses data_dir/<network>/). Defaults to ''default'' if absent.'
            cand --verbose 'Enable verbose structured logging'
            cand --json 'Emit machine-readable JSON where supported'
            cand --no-daemon 'Bypass the daemon and use an embedded node for supported commands'
            cand --embedded 'Bypass the daemon and use an embedded node for supported commands'
            cand -h 'Print help'
            cand --help 'Print help'
            cand version 'Show syncweb version information'
            cand start 'Start the local syncweb daemon'
            cand shutdown 'Stop the local syncweb node'
            cand status 'Show the local daemon status'
            cand reload 'Ask the local daemon to reload configuration'
            cand daemon-sync 'Ask the local daemon to trigger synchronization'
            cand create 'Create a synchronized folder and print a shareable URL'
            cand join 'Join a folder from an Iroh document ticket'
            cand leave 'Leave a synchronized folder, optionally deleting its local files'
            cand folders 'List managed folders'
            cand devices 'Show this device''s Iroh and Syncthing identities'
            cand config 'Show or update local configuration'
            cand ls 'List files in a local folder'
            cand find 'Search local files'
            cand sort 'Sort local files by discovery criteria'
            cand stat 'Show detailed metadata for a local file'
            cand download 'Download folder content or copy a local file'
            cand import 'Import local files into a synchronized folder'
            cand snapshot 'Manage content-addressed snapshots'
            cand transfer 'Inspect and control durable transfer jobs'
            cand watch 'Watch a folder and import filesystem changes'
            cand stats 'Show statistics for folders, files, and seeding status'
            cand verify 'Re-check local folder blob integrity'
            cand publish 'Publish a folder, blob, or catalog'
            cand unpublish 'Remove a public blob pin'
            cand package 'Create, version, publish, and manage collection packages'
            cand network 'Network connectivity utilities'
            cand db 'Database maintenance: check, vacuum, stats, backup'
            cand indexing 'Manage opt-in indexing, catalogs, and metadata'
            cand link 'Create and resolve stable syncweb links'
            cand mirror 'Mirror all blobs from a provider or network'
            cand provider 'Manage blob provider registrations'
            cand trust 'Inspect and delegate local trust'
            cand attest 'Sign content provenance attestations'
            cand moderation 'Manage local moderation decisions'
            cand completions 'Generate shell completions'
            cand manpages 'Generate manpages'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
        &'syncweb;version'= {
            cand --data-dir 'Directory used for persistent node identity and data'
            cand --verbose 'Enable verbose structured logging'
            cand --json 'Emit machine-readable JSON where supported'
            cand --no-daemon 'Bypass the daemon and use an embedded node for supported commands'
            cand --embedded 'Bypass the daemon and use an embedded node for supported commands'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'syncweb;start'= {
            cand --data-dir 'Override the global persistent data directory'
            cand --log-file 'Write daemon logs to this file'
            cand --max-threads 'max-threads'
            cand --sync-interval 'sync-interval'
            cand --beacon-port 'Base UDP port the beacon spreads network scopes over'
            cand --discovery-interface 'Restrict the beacon to a single network interface by name'
            cand --media-listen 'Media HTTP server listen address (e.g. 127.0.0.1:9193)'
            cand --bg 'Run in the background (daemon mode)'
            cand --media-only 'Run only the media HTTP server (standalone) and exit'
            cand --no-relay 'Disable Iroh relay mode (no relay server connections)'
            cand --no-mdns 'Disable mDNS local peer discovery'
            cand --no-beacon 'Disable the UDP beacon local peer discovery'
            cand --verbose 'Enable verbose structured logging'
            cand --json 'Emit machine-readable JSON where supported'
            cand --no-daemon 'Bypass the daemon and use an embedded node for supported commands'
            cand --embedded 'Bypass the daemon and use an embedded node for supported commands'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'syncweb;shutdown'= {
            cand --data-dir 'Directory used for persistent node identity and data'
            cand --force 'Skip graceful shutdown'
            cand --verbose 'Enable verbose structured logging'
            cand --json 'Emit machine-readable JSON where supported'
            cand --no-daemon 'Bypass the daemon and use an embedded node for supported commands'
            cand --embedded 'Bypass the daemon and use an embedded node for supported commands'
            cand -h 'Print help'
            cand --help 'Print help'
        }
        &'syncweb;status'= {
